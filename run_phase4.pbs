#!/bin/bash
#PBS -N llada-phase4
#PBS -A gs_ccds_taisp
#PBS -q gpu_bwp6000
#PBS -l select=1:ncpus=4:mem=64gb:ngpus=1
#PBS -l walltime=04:00:00
#PBS -j oe
set -eo pipefail
cd "${PBS_O_WORKDIR:?Submit from the repository root}"
module load anaconda2025/2025-gpu
source "$(conda info --base)/etc/profile.d/conda.sh"
conda activate dllm-unmasking
: "${HF_HOME:?Use the same existing scratch HF cache as Phase 3}"
export HF_HOME HF_HUB_OFFLINE=1 HF_DATASETS_OFFLINE=1 TRANSFORMERS_OFFLINE=1
export OMP_NUM_THREADS=4 TOKENIZERS_PARALLELISM=false CUBLAS_WORKSPACE_CONFIG=:4096:8
mkdir -p outputs/phase4/logs
exec > >(tee -a "outputs/phase4/logs/job-${PBS_JOBID}.log") 2>&1
# Imports resolve from the repository root, including read-only analysis dependencies.
python -c 'import phase4_sampler, run_phase4, analyze_phase25, analyze_phase15, run_phase2, phase2_data, phase2_samplers, phase3_schedule, evaluation'
python -u run_phase4.py --check-cache
args=()
case "${PHASE4_MODE:-full}" in
    smoke) args=(--smoke-test) ;;
    pilot) args=(--limit 20) ;;
    full) ;;
    *) echo 'PHASE4_MODE must be smoke, pilot, or full'; exit 1 ;;
esac
python -u run_phase4.py "${args[@]}"
