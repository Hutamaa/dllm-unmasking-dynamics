#!/bin/bash
#PBS -N llada-phase3
#PBS -A YOUR_PROJECT_CODE
#PBS -q gpu_bwp6000
#PBS -l select=1:ncpus=4:mem=64gb:ngpus=1
#PBS -l walltime=04:00:00
#PBS -j oe
set -euo pipefail
cd "${PBS_O_WORKDIR:?}"
module load anaconda2025/2025-gpu
source "$(conda info --base)/etc/profile.d/conda.sh"
conda activate dllm-unmasking
: "${HF_HOME:?Set to the existing offline Phase 2 cache}"
export HF_HOME HF_HUB_OFFLINE=1 HF_DATASETS_OFFLINE=1 TRANSFORMERS_OFFLINE=1
export OMP_NUM_THREADS=4 TOKENIZERS_PARALLELISM=false CUBLAS_WORKSPACE_CONFIG=:4096:8
mkdir -p outputs/phase3/logs
exec > >(tee -a "outputs/phase3/logs/job-${PBS_JOBID}.log") 2>&1
python -u run_phase3.py --check-cache
python -u run_phase3.py
