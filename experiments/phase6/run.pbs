#!/bin/bash
#PBS -N llada-phase6
#PBS -P YOUR_PROJECT_CODE
#PBS -q gpu_bwp6000
#PBS -l select=1:ncpus=4:mem=64gb:ngpus=1
#PBS -l walltime=08:00:00
#PBS -j oe
set -eo pipefail
cd "${PBS_O_WORKDIR:?Submit from the repository root}"
module load anaconda2025/2025-gpu
source "$(conda info --base)/etc/profile.d/conda.sh"
conda activate dllm-unmasking
: "${HF_HOME:?Use the established scratch Hugging Face cache}"
export HF_HOME HF_HUB_OFFLINE=1 HF_DATASETS_OFFLINE=1 TRANSFORMERS_OFFLINE=1
export OMP_NUM_THREADS=4 TOKENIZERS_PARALLELISM=false CUBLAS_WORKSPACE_CONFIG=:4096:8
policy="${PHASE6_POLICY:-both}"
case "$policy" in left_to_right|confidence|both) ;; *) echo 'Invalid PHASE6_POLICY'; exit 1 ;; esac
mkdir -p outputs/phase6/logs
exec > >(tee -a "outputs/phase6/logs/job-${PBS_JOBID}.log") 2>&1
python -c 'import experiments.phase6.run, dllm_unmasking.analyze_phase6, dllm_unmasking.samplers, dllm_unmasking.phase2_samplers, dllm_unmasking.phase2_data, experiments.phase2.run, dllm_unmasking.evaluation, dllm_unmasking.analyze_phase25, dllm_unmasking.analyze_phase15'
python -u -m experiments.phase6.run --check-cache
python -u -m experiments.phase6.run --policy "$policy"
